// fastfetch — shell greeting, printed on every new interactive shell.
// Symlinked to ~/.config/fastfetch/ by install/link.sh.
//
// Keep this fast: it runs on every new tab. No `command` modules (each one
// forks a process), no network-backed modules.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // The distro's built-in logo. To use the custom Arch mark with RL
  // initials instead, swap this block for:
  //   "type": "file",
  //   "source": "~/.config/fastfetch/logo/arch-rl.txt",
  //   "color": { "1": "cyan", "2": "magenta" },
  "logo": {
    "type": "builtin",
    "padding": { "top": 1, "right": 3 }
  },

  "display": {
    "separator": "  ",
    "key": { "width": 9 },
    "color": {
      "keys": "cyan",
      "title": "magenta"
    }
  },

  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    "separator",

    { "type": "os", "key": " OS" },
    { "type": "kernel", "key": " Kernel" },
    { "type": "uptime", "key": " Uptime" },
    { "type": "packages", "key": " Pkgs" },
    { "type": "shell", "key": " Shell" },
    { "type": "terminal", "key": " Term" },

    "break",

    { "type": "cpu", "key": " CPU", "showPeCoreCount": true },
    { "type": "memory", "key": " RAM" },
    { "type": "disk", "key": " Disk", "folders": "/" },

    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
