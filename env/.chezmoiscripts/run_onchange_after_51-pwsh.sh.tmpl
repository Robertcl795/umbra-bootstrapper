{{- if hasPrefix "wsl-" .os -}}
#!/usr/bin/env bash
{{ template "um-env.sh" . }}
# phase: {{ include "wsl/install/terminal.sh" | sha256sum }} terminal.sh
# theme: {{ .theme }} (Umbra's starship.toml for PowerShell follows it)
export UM_THEME={{ .theme | quote }}
component_enabled pwsh || phase_skip
bash "$UM_ENV_DIR/install/terminal.sh" --pwsh
{{- end }}
