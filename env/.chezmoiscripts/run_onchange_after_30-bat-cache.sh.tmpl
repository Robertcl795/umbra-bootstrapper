{{- if hasPrefix "wsl-" .os -}}
#!/usr/bin/env bash
# Rebuild bat's theme cache when the Umbra bat theme changes (Phase 1, ADR 0013).
# theme: {{ include "../themes/bat/Umbra.tmTheme" | sha256sum }}
set -euo pipefail
for bat in bat batcat; do
  if command -v "$bat" >/dev/null 2>&1; then
    "$bat" cache --build >/dev/null
    exit 0
  fi
done
echo "[INFO] bat not installed; its Umbra theme is in place for later." >&2
{{- end }}
