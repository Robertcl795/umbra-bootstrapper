{{- if or (hasPrefix "wsl-" .os) (eq .os "omarchy") -}}
#!/usr/bin/env bash
{{ template "um-env.sh" . }}
# phase: {{ include "wsl/install/detect_os.sh" | sha256sum }} detect_os.sh
# phase: {{ include "wsl/install/packages/ubuntu.sh" | sha256sum }} packages/ubuntu.sh
# phase: {{ include "wsl/install/packages/arch.sh" | sha256sum }} packages/arch.sh
# phase: {{ include "wsl/install/packages/omarchy.sh" | sha256sum }} packages/omarchy.sh
# shellcheck disable=SC1091
source "$UM_ENV_DIR/install/detect_os.sh"
detect_os
log_info "Profile: $UM_MODE${UM_COMPONENTS:+ · components: $UM_COMPONENTS}${UM_SKIP:+ · skip: $UM_SKIP}"
component_enabled packages || exit 0
case "$UM_OS" in
  ubuntu) bash "$UM_ENV_DIR/install/packages/ubuntu.sh" --run ;;
  arch) bash "$UM_ENV_DIR/install/packages/arch.sh" --run ;;
  omarchy) bash "$UM_ENV_DIR/install/packages/omarchy.sh" --run ;;
esac
phase_gate packages "base packages are missing; see the package manager output above" have_cmds git curl rg fzf zsh
{{- end }}
