{{- /* Theme chosen by the `theme` value (umbra, void, lux; ADR 0025);
       an unknown name falls back to umbra, generated from the brand tokens (ADR 0013). */ -}}
{{- $theme := .theme -}}
{{- if not (stat (joinPath .chezmoi.sourceDir ".chezmoitemplates" "starship" (printf "%s.toml" $theme))) -}}
{{-   $theme = "umbra" -}}
{{- end -}}
{{ include (printf ".chezmoitemplates/starship/%s.toml" $theme) -}}
