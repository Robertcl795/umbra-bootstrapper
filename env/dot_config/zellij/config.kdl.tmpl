// Zellij configuration — managed by Umbra (env/wsl)
// Docs: https://zellij.dev/documentation/configuration

theme "{{ if eq .theme "void" }}umbra-void{{ else if eq .theme "lux" }}umbra-lux{{ else }}umbra{{ end }}"
default_shell "zsh"

// UI
pane_frames true
mouse_mode true
scroll_buffer_size 100000
copy_on_select true
styled_underlines true

// Sessions survive detach and can be resurrected after restart
session_serialization true

// Keep default keybinds; add a few ergonomic extras
keybinds {
    shared_except "locked" {
        bind "Alt n" { NewPane; }
        bind "Alt t" { NewTab; }
        bind "Alt h" { MoveFocusOrTab "Left"; }
        bind "Alt l" { MoveFocusOrTab "Right"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }
    }
}
